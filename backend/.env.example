# ─────────────────────────────────────────────────────────────────
#  Backend Environment Variables (.env)
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/todo_db"

# Custom JWT secret — use a long, random string (min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Supabase project config
# Found at: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"  # Settings → API → JWT Secret

# Server
PORT=4000
